# Optional: copy this file to .env in the repository root.
# Environment variables override .env; defaults allow running without this file.
APP_NAME=DevDocs AI
# Allowed values: development, test, production. This is a label, not a security mode.
APP_ENV=development

# PostgreSQL: choose a local password in .env. Never commit a real password.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=devdocs
POSTGRES_USER=devdocs
POSTGRES_PASSWORD=

# Document ingestion: character-based chunks (not tokens).
MAX_UPLOAD_BYTES=10485760
MAX_EXTRACTED_CHARS=1000000
MAX_PDF_PAGES=200
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Local embedding model. Run: ollama pull embeddinggemma
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=120

# Answer generation uses OpenAI; embeddings still use local Ollama.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECONDS=120
OPENAI_API_KEY=
# Local alternative: LLM_PROVIDER=ollama and LLM_MODEL=llama3.2:1b.

# Logging and provider settings arrive in their own milestones.

# Provider credentials belong only in the backend environment.
# Never put secrets in browser-visible variables such as VITE_*.
