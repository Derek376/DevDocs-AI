# Optional: copy this file to .env in the repository root.
# Environment variables override .env; defaults allow running without this file.
APP_NAME=DevDocs AI
# Allowed values: development, test, production. This is a label, not a security mode.
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL: choose a local password in .env. Never commit a real password.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=devdocs
POSTGRES_USER=devdocs
POSTGRES_PASSWORD=

# Document ingestion: character-based chunks (not tokens).
MAX_UPLOAD_BYTES=10485760
MAX_EXTRACTED_CHARS=1000000
MAX_PDF_PAGES=200
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# OpenAI embeddings for indexing and semantic search.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=120

# Answer generation uses GPT; both providers use the same backend API key.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECONDS=120
OPENAI_API_KEY=

# Retrieval: similarity is a model-dependent score, not answer confidence.
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.35

# Compose host ports (database uses port 5432 inside the Docker network).
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Provider credentials belong only in the backend environment.
# Never put secrets in browser-visible variables such as VITE_*.
